// Copyright (C) 2026 Aditya Kar
//
// Multiplies the source by the RVM alpha matte. The source arrives
// premultiplied, so scaling all four channels keeps it premultiplied. Soft edge
// pixels first take the color from just inside the person, because the camera
// mixed the room's color into them. The person can then take on the light of
// the chosen room background.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d matte;
// Matte values below alpha_low become fully transparent and values above
// alpha_high fully opaque; values in between are eased with smoothstep.
uniform float alpha_low;
uniform float alpha_high;
// Automatic color: per-channel gains in linear light, then a mid-tone lift
// (a power below 1). Gains of 1 and a lift of 1 leave the color unchanged.
uniform float3 color_gain;
uniform float color_lift;
// Edge color cleanup looks this far inside the person, in texture coordinates.
// A height of 0 turns the cleanup off.
uniform float2 edge_reach;
// Blend into the room uses blurred copies of the room background. room_wrap is
// lightly blurred, room_light is very blurred and room_mean is one pixel.
// A room_blend of 0 turns this off.
uniform texture2d room_wrap;
uniform texture2d room_light;
uniform texture2d room_mean;
uniform float room_blend;
// The shader looks this far around a pixel for the person's edge, in texture
// coordinates.
uniform float2 room_reach;

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float srgb_to_linear(float c)
{
	return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

float linear_to_srgb(float c)
{
	return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

float3 apply_color(float3 rgb)
{
	float3 lin = float3(srgb_to_linear(rgb.r), srgb_to_linear(rgb.g), srgb_to_linear(rgb.b));
	lin = pow(saturate(lin * color_gain), float3(color_lift, color_lift, color_lift));
	return float3(linear_to_srgb(lin.r), linear_to_srgb(lin.g), linear_to_srgb(lin.b));
}

float matte_at(float2 uv)
{
	return matte.Sample(textureSampler, uv).r;
}

// Returns the color at uv if the matte calls it solid, and otherwise found.
float4 pick_solid(float4 found, float2 uv)
{
	return matte_at(uv) >= 0.9 ? image.Sample(textureSampler, uv) : found;
}

// Gives a soft edge pixel the nearest solid color, looking along the matte's
// slope toward the person. A pixel with no solid color in reach, such as a
// single strand of hair, keeps its own.
float4 clean_edge(float4 rgba, float m, float2 uv)
{
	float2 slope = float2(matte_at(uv + float2(edge_reach.x, 0.0)) - matte_at(uv - float2(edge_reach.x, 0.0)),
			      matte_at(uv + float2(0.0, edge_reach.y)) - matte_at(uv - float2(0.0, edge_reach.y)));
	float strength = length(slope);
	float2 inward = slope / max(strength, 0.0001) * edge_reach;

	// The nearest solid sample is checked last, so it wins.
	float4 solid_color = rgba;
	solid_color = pick_solid(solid_color, uv + inward);
	solid_color = pick_solid(solid_color, uv + inward * 0.75);
	solid_color = pick_solid(solid_color, uv + inward * 0.5);
	solid_color = pick_solid(solid_color, uv + inward * 0.25);

	// Solid pixels and flat parts of the matte keep their own color.
	float amount = (1.0 - smoothstep(0.9, 1.0, m)) * smoothstep(0.02, 0.1, strength);
	return lerp(rgba, solid_color, amount);
}

// Returns the mean of eight matte samples around uv, from 0 to 1.
float matte_around(float2 uv)
{
	float2 d = room_reach * 0.7;
	float sum = matte_at(uv + float2(room_reach.x, 0.0)) + matte_at(uv - float2(room_reach.x, 0.0)) +
		    matte_at(uv + float2(0.0, room_reach.y)) + matte_at(uv - float2(0.0, room_reach.y)) +
		    matte_at(uv + d) + matte_at(uv - d) + matte_at(uv + float2(d.x, -d.y)) +
		    matte_at(uv + float2(-d.x, d.y));
	return sum * 0.125;
}

// Lights the person to suit the room. Each side takes the brightness of the
// room beside it, the whole person takes a little of the room's color, and the
// edge takes the color of the room right behind it. rgb is premultiplied by a.
float3 blend_room(float3 rgb, float a, float2 uv)
{
	float3 luma = float3(0.299, 0.587, 0.114);
	float3 mean = room_mean.Sample(textureSampler, float2(0.5, 0.5)).rgb;
	float3 light = room_light.Sample(textureSampler, uv).rgb;
	float gray = dot(mean, luma);

	float shade = clamp((dot(light, luma) + 0.1) / (gray + 0.1), 0.7, 1.3);
	float3 tint = clamp((mean + float3(0.1, 0.1, 0.1)) / (gray + 0.1), 0.8, 1.25);
	float3 lit = lerp(rgb, saturate(rgb * tint * shade), room_blend);

	float rim = saturate(1.0 - matte_around(uv));
	float3 wrap = room_wrap.Sample(textureSampler, uv).rgb * a;
	return lerp(lit, wrap, rim * 0.5 * room_blend);
}

float4 PSMatte(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, v_in.uv);
	float m = matte_at(v_in.uv);
	float a = smoothstep(alpha_low, alpha_high, m);

	if (edge_reach.y > 0.0)
		rgba = clean_edge(rgba, m, v_in.uv);

	// The camera image is opaque here, but undo any premultiplication so the
	// color math sees true colors.
	float3 gain_change = abs(color_gain - float3(1.0, 1.0, 1.0));
	if (color_lift != 1.0 || gain_change.r + gain_change.g + gain_change.b > 0.0) {
		float inv = rgba.a > 0.0 ? 1.0 / rgba.a : 0.0;
		rgba.rgb = apply_color(rgba.rgb * inv) * rgba.a;
	}

	if (room_blend > 0.0)
		rgba.rgb = blend_room(rgba.rgb, rgba.a, v_in.uv);

	return rgba * a;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMatte(v_in);
	}
}

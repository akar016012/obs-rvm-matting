// Copyright (C) 2026 Aditya Kar
//
// Multiplies the source by the RVM alpha matte. The source arrives
// premultiplied, so scaling all four channels keeps it premultiplied. The
// matte texture's second channel marks where to remove the chair's color
// spill.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d matte;
// Matte values below alpha_low become fully transparent and values above
// alpha_high fully opaque; values in between are eased with smoothstep.
uniform float alpha_low;
uniform float alpha_high;
// Automatic color: per-channel gains in linear light, then a mid-tone lift
// (a power below 1). Gains of 1 and a lift of 1 leave the color unchanged.
uniform float3 color_gain;
uniform float color_lift;

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float srgb_to_linear(float c)
{
	return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

float linear_to_srgb(float c)
{
	return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

float3 apply_color(float3 rgb)
{
	float3 lin = float3(srgb_to_linear(rgb.r), srgb_to_linear(rgb.g), srgb_to_linear(rgb.b));
	lin = pow(saturate(lin * color_gain), float3(color_lift, color_lift, color_lift));
	return float3(linear_to_srgb(lin.r), linear_to_srgb(lin.g), linear_to_srgb(lin.b));
}

float4 PSMatte(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, v_in.uv);
	float2 m = matte.Sample(textureSampler, v_in.uv).rg;
	float a = smoothstep(alpha_low, alpha_high, m.r);

	// Near a removed chair, leftover pixels with the chair's magenta tint
	// (more blue than green) have their red pulled down to their other
	// channels, so they read as neutral shadow rather than a red fringe.
	// Skin has more green than blue and is left alone.
	float magenta = saturate((rgba.b - rgba.g) * 8.0);
	float neutral_red = min(rgba.r, max(rgba.g, rgba.b));
	rgba.r = lerp(rgba.r, neutral_red, m.g * magenta);

	// The camera image is opaque here, but undo any premultiplication so the
	// color math sees true colors.
	float3 gain_change = abs(color_gain - float3(1.0, 1.0, 1.0));
	if (color_lift != 1.0 || gain_change.r + gain_change.g + gain_change.b > 0.0) {
		float inv = rgba.a > 0.0 ? 1.0 / rgba.a : 0.0;
		rgba.rgb = apply_color(rgba.rgb * inv) * rgba.a;
	}

	return rgba * a;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMatte(v_in);
	}
}
